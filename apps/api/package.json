    "db": "tsx src/scripts/dev-db.ts",
    "seed:prod": "node dist/seed.js"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
