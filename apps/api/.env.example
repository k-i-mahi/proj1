# Copy to apps/api/.env and adjust. Every value has a safe development default.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/civita

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to call the API with cookies.
WEB_ORIGIN=http://localhost:5173
# Public URL of this API (used for locally stored upload URLs).
API_PUBLIC_URL=http://localhost:4000
# Use "none" when the web app and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
# Number of proxies in front of the API (1 behind Render/Railway/nginx).
TRUST_PROXY=0

# Optional: store images on Cloudinary instead of the local disk.
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud_name>

# Optional: send real emails (password reset). Without it, emails are printed to the log.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Civita <no-reply@civita.local>"
