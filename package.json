{
  "name": "civita",
  "version": "2.0.0",
  "private": true,
  "description": "Civic issue tracker: residents report local problems, authorities resolve them in real time.",
  "license": "MIT",
  "author": "mahi (https://github.com/k-i-mahi)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @civita/api\" \"npm run dev -w @civita/web\"",
    "dev:db": "npm run db -w @civita/api",
    "seed": "npm run seed -w @civita/api",
    "build": "npm run build -w @civita/api && npm run build -w @civita/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @civita/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module"
}
